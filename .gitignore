# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Test results and temporary logs
test-results/
*.log

# Local deployment secrets (never commit secrets to git)
deploy/overlays/*/secrets.env
deploy/overlays/*/nats.creds
*.env
!*.env.example
!deploy/overlays/*/config.env
*.creds
!*.creds.example
