# Secret Configuration Template for Nvuto Consent (Production Environment)
# COPY THIS FILE TO 'secrets.env' AND POPULATE WITH REAL PRODUCTION CREDENTIALS.
# NEVER COMMIT 'secrets.env' CONTAINING REAL CREDENTIALS TO VERSION CONTROL.

# Database URL for YugabyteDB YSQL connection (must use TLS verification in production)
database-url=postgres://consent_prod_user:REPLACE_WITH_PRODUCTION_PASSWORD@yb-tserver.yugabyte.svc.cluster.local:5433/consent?sslmode=verify-full&sslrootcert=/etc/ssl/certs/yb-root.crt

# Note: JWT_HMAC_SECRET must NEVER be configured in production. Production strictly requires asymmetric OIDC/JWKS.
