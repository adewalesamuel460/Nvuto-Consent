# Secret Configuration Template for Nvuto Consent (Staging Environment)
# COPY THIS FILE TO 'secrets.env' AND POPULATE WITH REAL STAGING CREDENTIALS.
# NEVER COMMIT 'secrets.env' CONTAINING REAL CREDENTIALS TO VERSION CONTROL.

# Database URL for YugabyteDB YSQL connection (must use TLS verification)
database-url=postgres://consent_staging_user:REPLACE_WITH_STAGING_PASSWORD@yb-tserver.yugabyte-staging.svc.cluster.local:5433/consent?sslmode=verify-full&sslrootcert=/etc/ssl/certs/yb-root.crt

# Optional HMAC secret for development/staging tokens (only enabled if explicitly opted-in)
# jwt-hmac-secret=REPLACE_WITH_BASE64_HMAC_SECRET
